APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=4000

# MySQL lokal dari Docker Compose Arsant Screener
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=arsant_local
DB_NAME=arsant_screener

REDIS_ADDR=127.0.0.1:6379

ANTHROPIC_API_KEY=

# Untuk VPS: isi dengan rahasia acak lalu masukkan nilai yang sama pada extension.
INGEST_API_KEY=

# Untuk VPS: isi dengan domain frontend, mis. https://app.arsantscreener.com
CORS_ALLOWED_ORIGINS=*
