[Unit]
Description=Arsant Stockbit authenticated browser
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/srv/arsant-data

[Service]
Type=simple
User=opc
ExecStart=/usr/local/sbin/arsant-stockbit-browser
Restart=always
RestartSec=10
KillMode=control-group
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/arsant-data/stockbit-session /tmp

[Install]
WantedBy=multi-user.target
